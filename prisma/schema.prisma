generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProofStatus {
  PENDING
  VERIFYING
  APPROVED
  REJECTED
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum ClaimStatus {
  ACTIVE
  RELEASED
  EXPIRED
}

enum UserRole {
  USER
  VALIDATOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  wallet    String   @unique
  name      String?
  bio       String?
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(USER)
  email     String?
  webhookUrl String? @map("webhook_url")
  validatorReputation Int @default(0) @map("validator_reputation")
  reviewCount Int      @default(0) @map("review_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proofs Proof[]
  claims TaskClaim[]
  notifications Notification[]
  validatorVotes ValidatorVote[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  description String?
  type      String
  rewardAmount Float  @map("reward_amount")
  rewardToken String? @map("reward_token")
  lat       Float
  lng       Float
  radiusMeters Float  @default(100) @map("radius_meters")
  maxCompletions Int?   @map("max_completions")
  status    TaskStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  proofs  Proof[]
  claims  TaskClaim[]

  @@map("tasks")
}

model TaskClaim {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  status    ClaimStatus @default(ACTIVE)
  claimedAt DateTime @default(now()) @map("claimed_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, userId])
  @@map("task_claims")
}

model Proof {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  taskId    String      @map("task_id")
  status    ProofStatus @default(PENDING)
  lat       Float?
  lng       Float?
  notes     String?
  rewardedAt DateTime?  @map("rewarded_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id])
  task       Task          @relation(fields: [taskId], references: [id])
  photos     ProofPhoto[]
  verifications Verification[]
  validatorVotes ValidatorVote[]

  @@map("proofs")
}

model ProofPhoto {
  id         String    @id @default(uuid())
  proofId    String    @map("proof_id")
  cid        String
  filename   String
  sha256     String?   @unique
  width      Int?
  height     Int?
  capturedAt DateTime? @map("captured_at")

  proof Proof @relation(fields: [proofId], references: [id])

  @@index([sha256])
  @@map("proof_photos")
}

model Verification {
  id         String   @id @default(uuid())
  proofId    String   @map("proof_id")
  verifierId String   @map("verifier_id")
  verdict    String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  proof Proof @relation(fields: [proofId], references: [id])

  @@map("verifications")
}

model ValidatorVote {
  id          String    @id @default(uuid())
  proofId     String    @map("proof_id")
  validatorId String    @map("validator_id")
  verdict     String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  proof     Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  validator User  @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([proofId, validatorId])
  @@index([validatorId, decidedAt])
  @@map("validator_votes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@map("AuditLog")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  type         String
  title        String
  body         String?
  channel      String?
  deliveredAt  DateTime? @map("delivered_at")
  deliveryError String?  @map("delivery_error")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}
