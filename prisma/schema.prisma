generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProofStatus {
  PENDING
  VERIFYING
  APPROVED
  REJECTED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

model User {
  id        String   @id @default(uuid())
  wallet    String   @unique
  name      String?
  bio       String?
  avatarUrl String?  @map("avatar_url")
  role      String   @default("user")
  email     String?
  webhookUrl String? @map("webhook_url")
  validatorReputation Int @default(0) @map("validator_reputation")
  reviewCount Int      @default(0) @map("review_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proofs Proof[]
  claims TaskClaim[]
  notifications Notification[]
  validatorVotes ValidatorVote[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  description String?
  type      String
  rewardAmount Float  @map("reward_amount")
  rewardToken String? @map("reward_token")
  lat       Float
  lng       Float
  radiusMeters Float  @default(100) @map("radius_meters")
  maxCompletions Int?   @map("max_completions")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  proofs  Proof[]
  claims  TaskClaim[]

  @@map("tasks")
}

model TaskClaim {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  taskId    String   @map("task_id")
  status    String   @default("active")
  claimedAt DateTime @default(now()) @map("claimed_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, userId])
  // getTaskClaims: WHERE task_id = ? AND status = 'active' AND expires_at > now()
  @@index([taskId, status])
  @@map("task_claims")
}

model Proof {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  taskId    String      @map("task_id")
  status    ProofStatus @default(PENDING)
  lat       Float?
  lng       Float?
  notes     String?
  rewardedAt DateTime?  @map("rewarded_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id])
  task       Task          @relation(fields: [taskId], references: [id])
  photos     ProofPhoto[]
  verifications Verification[]
  validatorVotes ValidatorVote[]

  // Hot-path query shapes (see docs/index-verification.md):
  //  - (user_id, status): getUserImpact aggregation
  //  - (status, created_at): admin review queue listPendingProofs
  //    (equality on status, sort on created_at)
  //  - (task_id, status): capacity checks + completeTaskIfFull
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([taskId, status])
  @@map("proofs")
}

model ProofPhoto {
  id         String    @id @default(uuid())
  proofId    String    @map("proof_id")
  cid        String
  filename   String
  sha256     String?   @unique
  width      Int?
  height     Int?
  capturedAt DateTime? @map("captured_at")

  proof Proof @relation(fields: [proofId], references: [id])

  // FK join index for loading a proof's photos; the unique sha256 key
  // already serves hash lookups, so the previous plain @@index([sha256])
  // was redundant and has been dropped (see migration ...0008).
  @@index([proofId])
  // Covering index for the duplicate-photo check
  // (WHERE sha256 IN (...) AND proofId != ?) — enables an index-only scan.
  @@index([sha256, proofId])
  @@map("proof_photos")
}

model Verification {
  id         String   @id @default(uuid())
  proofId    String   @map("proof_id")
  verifierId String   @map("verifier_id")
  verdict    String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  proof Proof @relation(fields: [proofId], references: [id])

  // FK join index: proofs are loaded with their verifications
  // (GET /proofs/:id, review flows, verification worker).
  @@index([proofId])
  @@map("verifications")
}

model ValidatorVote {
  id          String    @id @default(uuid())
  proofId     String    @map("proof_id")
  validatorId String    @map("validator_id")
  verdict     String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  proof     Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  validator User  @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([proofId, validatorId])
  @@index([validatorId, decidedAt])
  @@map("validator_votes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json     @default("{}")
  ip         String?
  outcome    String?  // "SUCCESS" | "FAILURE"
  statusCode Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
  // getAuditLogs with both filters: WHERE "userId" = ? AND resource = ?
  // ORDER BY "createdAt" DESC LIMIT ? OFFSET ?
  @@index([userId, resource, createdAt(sort: Desc)])
  @@map("AuditLog")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  type         String
  title        String
  body         String?
  channel      String?
  deliveredAt  DateTime? @map("delivered_at")
  deliveryError String?  @map("delivery_error")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Transactional outbox for notification dispatch. A row is created in the
// SAME database transaction as the event that triggers the notification
// (e.g. a proof status change), so a crash before the BullMQ enqueue still
// leaves a recoverable PENDING row that the outbox drainer can pick up and
// enqueue after restart. Once max attempts are exceeded the row is moved to
// DEAD_LETTER so failures are observable instead of silently dropped.
model NotificationOutbox {
  id             String                    @id @default(uuid())
  notificationId String                    @map("notification_id")
  requestId      String?                   @map("request_id")
  status         NotificationOutboxStatus  @default(PENDING)
  attempts       Int                       @default(0)
  lastError      String?                   @map("last_error")
  nextAttemptAt  DateTime                  @default(now()) @map("next_attempt_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}
