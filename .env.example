# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://ecotask:ecotask@localhost:5432/ecotask

# Redis
REDIS_URL=redis://localhost:6379

# Background job timing (milliseconds)
EXPIRY_SWEEP_INTERVAL_MS=900000

# Per-user rate limits
PROOF_RATE_LIMIT_WINDOW_MS=3600000
PROOF_RATE_LIMIT_MAX=20
CLAIM_RATE_LIMIT_WINDOW_MS=3600000
CLAIM_RATE_LIMIT_MAX=50

# Validator program
VALIDATOR_ASSIGNMENT_COUNT=3
VALIDATOR_QUORUM_REQUIRED=2

# Stellar
STELLAR_NETWORK=testnet
STELLAR_ORACLE_SECRET_KEY=
REWARD_ENGINE_CONTRACT_ID=

# IPFS
WEB3_STORAGE_TOKEN=

# Notifications
NOTIFICATION_WEBHOOK_TIMEOUT_MS=5000
NOTIFICATION_EMAIL_FROM=EcoTask <no-reply@ecotask.network>

# Auth
# Development only. Generate a fresh random secret for every deployment.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
